# Public URL of the deployed site (used for SEO tags, sitemap and product links in order messages)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: WhatsApp number with country code, digits only (e.g. 919876543210). Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: contact email. Leave empty to hide email options.
NEXT_PUBLIC_CONTACT_EMAIL=
